{
  "name": "shop",
  "sourceRoot": "apps/shop/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --host 0.0.0.0 --port 4174",
        "cwd": "apps/shop"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/shop/dist"],
      "options": {
        "command": "vite build",
        "cwd": "apps/shop"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/shop"
      }
    }
  }
}
